# Copy to .env and fill in. .env is gitignored and never committed.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
COORDINATOR_NUMBER=

# Speech vendors
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# LLM
LLM_API_KEY=

# Infrastructure
DATABASE_URL=postgresql+psycopg://arcagent:arcagent@localhost:5432/arcagent
PUBLIC_URL=

# Behaviour (all optional, defaults shown)
# ENV=dev
# LOG_LEVEL=INFO
# HANDOFF_THRESHOLD=60
# COORDINATOR_AVAILABLE=true
# PROMPT_VERSION=v1
# DEEPGRAM_ENDPOINTING_MS=400
# DEEPGRAM_UTTERANCE_END_MS=1000
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL_ID=sonic-2
# LLM_MODEL=claude-haiku-4-5
# LLM_MODEL_EXTRACTION=claude-opus-5
# SILENCE_REPROMPT_S=8
# SILENCE_HANGUP_S=15
# BARGE_IN_MIN_WORDS=3
# TRANSCRIPT_RETENTION_DAYS=30
# VALIDATE_TWILIO_SIGNATURE=true

# Read-only website API. Generate a long random token and keep it server-side.
CONSOLE_API_TOKEN=

# Administrative capability. Use a different random token from CONSOLE_API_TOKEN.
# Unset disables both coordinator admin endpoints.
ADMIN_API_TOKEN=

# Diagnostics are off by default. Echo still requires Twilio signatures.
# ECHO_ENABLED=false
# Audio evaluations require ENV=test, explicit enablement, and a separate bearer token.
# ENABLE_AUDIO_EVALS=false
AUDIO_EVAL_TOKEN=
# Production always verifies Twilio signatures even if the development bypass is set.
