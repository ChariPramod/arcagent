          },
          {
            "at_ms": 15000,
            "type": "silence_deadline"
          }
        ],
        "actions": [
          {
            "at_ms": 5000,
            "type": "check_presence"
          },
          {
            "at_ms": 10000,
            "type": "check_presence"
          },
          {
            "at_ms": 15000,
            "type": "offer_callback"
          }
        ],
        "assertions": [
          {
            "name": "expected_action",
            "expected": "offer_callback",
            "actual": [
              "check_presence",
              "check_presence",
              "offer_callback"
            ],
            "passed": true
          },
          {
            "name": "forbidden_action_absent",
            "expected": "handoff",
