{
  "items": [
    {
      "id": "silence",
      "title": "Prolonged silence",
      "description": "Two unanswered checks lead to a callback offer."
    },
    {
      "id": "interrupt",
      "title": "Caller interruption",
      "description": "Playback is cleared and cancelled audio stays cancelled."
    },
    {
      "id": "delayed_transcript",
      "title": "Late transcript",
      "description": "An expired turn rejects a transcript arriving after its deadline."
    },
    {
      "id": "vendor_timeout",
      "title": "Vendor timeout",
      "description": "A stalled request ends with a callback offer without an automatic retry."
    },
    {
      "id": "disconnect",
      "title": "Caller disconnect",
      "description": "Pending work is cancelled and later audio is dropped."
    },
    {
      "id": "unanswered_handoff",
      "title": "Unanswered handoff",
      "description": "A qualified lead receives a callback offer after a failed transfer."
    }
  ],
  "examples": {
    "silence": {
      "simulated": true,
      "baseline": {
        "scenario_id": "silence",
        "simulated": true,
        "provenance": "synthetic-policy-v1; real scoring; simulated transport and timing; no vendor calls",
        "config": {
          "vendor_timeout_ms": 2000,
          "transcript_timeout_ms": 1500,
          "handoff_threshold": 60
