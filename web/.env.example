# Server-only. Use the HTTPS origin of the deployed FastAPI service.
ARCAGENT_API_URL=
# Must match CONSOLE_API_TOKEN on the FastAPI service.
ARCAGENT_API_TOKEN=
# Comma-separated trusted user IDs (Sites IDs or native oidc: account IDs) permitted to read this workspace.
ARCAGENT_ALLOWED_USER_IDS=

# Native Vercel sign-in. Register an OIDC confidential web application first.
# Exact HTTPS origin, without trailing slash. Register origin + /auth/callback.
ARCAGENT_AUTH_ORIGIN=
ARCAGENT_OIDC_ISSUER=
ARCAGENT_OIDC_CLIENT_ID=
ARCAGENT_OIDC_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Separate from API token. Server-only; rotating invalidates sessions.
ARCAGENT_AUTH_SECRET=
